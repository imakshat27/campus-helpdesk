# Copy to backend/.env. Never use a production database for tests.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
STAFF_USERNAME=
STAFF_PASSWORD=
STUDENT_USERNAME=
STUDENT_PASSWORD=
# Use at least 16 characters for new passwords; minimum 8 for existing credentials; provision with python -m app.provision_accounts.
COOKIE_SECURE=true
SESSION_MAX_AGE=28800
CHAT_ENABLED=true
CHAT_REQUESTS_PER_MINUTE=10
CHAT_REQUESTS_PER_DAY=100
SESSION_REQUESTS_PER_MINUTE=5
SESSION_REQUESTS_PER_DAY=30
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_THRESHOLD=0.35
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# official (default) or sample; run the importer before official seeding.
KNOWLEDGE_MODE=official
